# Copy this file to .env and fill it in. .env is gitignored: never commit real keys.

# Model for `heaw run` when --model is not given, as provider:model.
# For Azure, the model part is your deployment name.
HEAW_MODEL=azure:your-deployment-name

# Azure OpenAI (Microsoft Foundry): key and endpoint from the resource's "Keys and Endpoint"
# page. The endpoint can be the resource URL (https://<name>.openai.azure.com/) or a
# deployment's full "Target URI"; both work.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# Which Azure API to call: responses (default, for OpenAI models) or chat (also works for
# non-OpenAI models deployed in Foundry).
# AZURE_OPENAI_API=responses

# Other providers
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
