{
  "name": "harness-engineered-agentic-workflow",
  "version": "0.0.0",
  "description": "A provider-agnostic, extensible agent harness for TypeScript: agent loop, tools, MCP, permissions, hooks, sub-agents and a CLI.",
  "keywords": [
    "agent",
    "agentic",
    "ai",
    "llm",
    "harness",
    "mcp",
    "cli"
  ],
  "license": "MIT",
  "author": "Daniil Kozlov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaDozlov/harness-agent.git"
  },
  "homepage": "https://github.com/DaDozlov/harness-agent#readme",
  "bugs": {
    "url": "https://github.com/DaDozlov/harness-agent/issues"
  },
  "type": "module",
  "bin": {
    "heaw": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run lint:deps && npm run format:check && npm test",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.91",
    "@ai-sdk/azure": "^4.0.112",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@ai-sdk/provider": "^4.0.34",
    "@modelcontextprotocol/client": "^2.4.0",
    "@vscode/ripgrep": "^1.18.0",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "jiti": "^2.7.0",
    "marked": "^18.1.2",
    "marked-terminal": "^7.3.1",
    "node-html-markdown": "^2.0.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@xterm/headless": "^6.0.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
