# Copy to .env (git ignores it) and fill in.

# The model (see heaw.config.ts). For Azure OpenAI:
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=

# A fine-grained GitHub token for this one repository (see README.md for the permissions).
GITHUB_TOKEN=

# Jira (Atlassian's remote MCP server) uses a login instead: heaw mcp login atlassian
